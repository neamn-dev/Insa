# ==========================================
# SyncWrite — Comprehensive .gitignore
# ==========================================

# ------------------------------------------
# Environment & Secrets (Never commit credentials)
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
firebase-service-account*.json

# ------------------------------------------
# Python & Flask Backend
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.Python
env/
venv/
.venv/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
htmlcov/
*.log

# Backend specific virtualenvs & caches
backend/__pycache__/
backend/*/__pycache__/
backend/venv/
backend/.venv/
backend/.pytest_cache/

# ------------------------------------------
# Databases & Local Storage
# ------------------------------------------
*.db
*.sqlite
*.sqlite3
database/
data/
backend/database/
backend/data/

# ------------------------------------------
# Node.js & React Frontend
# ------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/dist-ssr/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ------------------------------------------
# IDE & Code Editors
# ------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.settings/
.zed/

# ------------------------------------------
# Operating System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
