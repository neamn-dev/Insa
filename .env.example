# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/syncwrite"

# Application Security Keys
SECRET_KEY="demo-flask-auth-secret-key-change-in-production"
JWT_SECRET_KEY="jwt-demo-secret-key-syncwrite"

# Google OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://127.0.0.1:5000/api/auth/google/callback"
